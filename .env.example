# SmartPark Environment Configuration

# Flask Secret Key for session management
SECRET_KEY=smartpark-secret-key-super-secure-change-in-prod-2026

# Database Type: 'mysql' (default for production/PBL-I submission) or 'sqlite' (instant zero-config local testing)
DB_TYPE=mysql

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=smart_parking

# Server Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
